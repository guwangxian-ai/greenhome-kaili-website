---
import Layout from '../../layouts/Layout.astro';
import { guides, company, type Guide } from '../../data/company';
export function getStaticPaths() { return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
interface Props { guide: Guide }
const { guide } = Astro.props;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: guide.title,
  description: guide.description, inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: company.fullName },
  ...(Astro.site ? { mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href } : {}),
};
---
<Layout title={`${guide.title}｜凯里绿色家装饰装修指南`} description={guide.description} schema={articleSchema}>
  <main id="main-content" class="site-main">
    <article class="article-shell">
      <div class="breadcrumb"><a href="/">首页</a><span>/</span><a href="/guides/">装修指南</a><span>/</span><span>{guide.category}</span></div>
      <header class="article-header">
        <p class="article-category">{guide.category}</p><h1>{guide.title}</h1><p class="article-lead">{guide.description}</p>
        <div class="article-byline"><span>凯里绿色家装饰装修指南</span><span>约 {guide.readingMinutes} 分钟阅读</span></div>
      </header>
      <div class="article-layout">
        <div class="article-prose">
          {guide.sections.map((section, index) => <section id={`point-${index + 1}`}><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
          <aside class="article-callout"><h2>把你家的情况，具体聊一聊。</h2><p>本文为装修沟通参考。实际施工方案、费用和售后约定，应结合房屋情况与正式合同确认。</p><a class="button button-primary" href={company.tel}>拨打 {company.phone}<span aria-hidden="true">↗</span></a></aside>
        </div>
        <nav class="article-sidebar" aria-label="文章目录"><p>这篇文章聊什么</p>{guide.sections.map((section, index) => <a href={`#point-${index + 1}`}>{section.heading}</a>)}</nav>
      </div>
      <aside class="article-related"><h2>也许你还想了解</h2>{guides.filter((other) => other.slug !== guide.slug).map((other) => <a href={`/guides/${other.slug}/`}>{other.title}<span aria-hidden="true">↗</span></a>)}</aside>
    </article>
  </main>
</Layout>
