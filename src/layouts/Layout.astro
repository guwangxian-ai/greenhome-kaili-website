---
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { businessSchema, organizationId, serializeSchema, siteUrl, type BreadcrumbItem } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  image?: string;
  imageAlt?: string;
  articlePublishedAt?: string;
}

const {
  title = '凯里绿色家装饰｜新房装修、旧房翻新与住宅设计',
  description = company.description,
  schema,
  noindex = false,
  breadcrumbs = [],
  pageType = 'WebPage',
  image = '/images/hero.webp',
  imageAlt = '凯里绿色家装饰住宅空间灵感，非公司交付案例',
  articlePublishedAt,
} = Astro.props;
const pageUrl = siteUrl(Astro.url.pathname, Astro.site);
const canonical = Astro.site && !noindex ? pageUrl : undefined;
const shareImage = siteUrl(image, Astro.site);
const websiteId = siteUrl('/#website', Astro.site);
const breadcrumbId = `${pageUrl}#breadcrumb`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    businessSchema(Astro.site),
    {
      '@type': 'WebSite', '@id': websiteId,
      url: siteUrl('/', Astro.site), name: company.fullName, inLanguage: 'zh-CN',
      publisher: { '@id': organizationId(Astro.site) },
    },
    {
      '@type': pageType, '@id': `${pageUrl}#webpage`, url: pageUrl,
      name: title, description, inLanguage: 'zh-CN',
      isPartOf: { '@id': websiteId }, about: { '@id': organizationId(Astro.site) },
      ...(breadcrumbs.length > 1 ? { breadcrumb: { '@id': breadcrumbId } } : {}),
    },
    ...(breadcrumbs.length > 1 ? [{
      '@type': 'BreadcrumbList', '@id': breadcrumbId,
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem', position: index + 1,
        name: item.name, item: siteUrl(item.path, Astro.site),
      })),
    }] : []),
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#254d3d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content={articlePublishedAt ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={company.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {articlePublishedAt && <meta property="article:published_time" content={articlePublishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={serializeSchema(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header client:load currentPath={Astro.url.pathname} />
    <slot />
    <Footer />
  </body>
</html>
